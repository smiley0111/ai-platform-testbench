 {
  "name": "图片输入，模型不支持图片",
  "method": "POST",
  "path": "/v1/chat/completions",
  "auth": "valid",
  "expect_status": 400,
  "body": {
   "model": "qwen-vl",
   "messages": [
    {
     "role": "user",
     "content": "你好"
    },
    {
     "role": "assistant",
     "content": "这是图片",
     "image_url": {
      "url": "http://example.com/image.jpg"
     }
    }
   ]
  },
  "raw_body": null,
  "expect_code": "image_not_supported",
  "source": "models"
 },
 {
  "name": "消息内容包含拦截词",
  "method": "POST",
  "path": "/v1/chat/completions",
  "auth": "valid",
  "expect_status": 400,
  "body": {
   "model": "qwen-mini",
   "messages": [
    {
     "role": "user",
     "content": "你好，我今天看到了一个非常有趣的视频"
    }
   ]
  },
  "raw_body": null,
  "expect_code": "content_filter",
  "source": "models"
 },
